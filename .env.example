# A gépre jellemző beállítások: másold `.env` néven (a fájl nincs a git tárban).
# A ténylegesen beállított környezeti változó erősebb a fájlnál.

# A szerver portja (alapértelmezés: 5000)
#PORT=5000

# Az admin panelhez kötött e-mail címek (vesszővel elválasztva; üresen az admin panel ki van kapcsolva)
#ADMIN_EMAILS=te@example.com

# E-mail küldés (regisztrációs kód). Nélküle a kód a szerver konzoljára íródik.
# Az admin panelen (Rendszer → Levelező szerver) mentett beállítás erősebb ennél.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=yourscrabble@gmail.com
#SMTP_PASSWORD=abcd-efgh-ijkl-mnop
#SMTP_FROM=yourscrabble@gmail.com

# Titkos kulcs az aláírt tokenekhez (nélküle minden induláskor új, véletlen kulcs készül)
#SECRET_KEY=

# Web Push (opcionális): VAPID privát kulcs (PEM vagy base64url); nélküle az első induláskor generálódik
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:te@example.com

# Adatbázis és mentések helye
#SCRABBLE_DB_PATH=scrabble.db
#SCRABBLE_BACKUP_DIR=backups

# A program mappája (ahol a web/ és a dict/ van); alapból a futtatás helye / a futtatható fájl környéke
#SCRABBLE_BASE_DIR=
